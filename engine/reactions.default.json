{
  "format": "capsule-reactions",
  "version": 1,
  "_comment": "expressions = held poses (absolute parameter targets). motions = one-shot keyframe tracks [ms, value, ease?]; mode add = offset on top of idle, override = replace. reactions = Capsule trigger_type -> candidates (intensity 1 눈치 / 2 말 걸기 / 3 서운함, weight = random pick weight).",

  "expressions": {
    "neutral":  { "params": {} },
    "smile":    { "params": { "eyeOpenL": 0, "eyeOpenR": 0, "brow": 0.45, "mouthForm": 0.9, "mouthCForm": 0.5 } },
    "softSmile":{ "params": { "eyeOpenL": 0.7, "eyeOpenR": 0.7, "brow": 0.25, "mouthForm": 0.7 } },
    "surprise": { "params": { "brow": 1, "mouthOpen": 0.6, "mouthForm": -0.1, "irisScale": 0.75 } },
    "stare":    { "params": { "eyeOpenL": 0.45, "eyeOpenR": 0.45, "brow": -0.6, "mouthForm": -0.4, "mouthCForm": -0.3 } },
    "pout":     { "params": { "eyeOpenL": 0.7, "eyeOpenR": 0.7, "brow": -0.45, "browAngSym": -0.5, "mouthForm": -0.8, "mouthCForm": -1, "mouthCY": 0.15 } },
    "worried":  { "params": { "eyeOpenL": 0.85, "eyeOpenR": 0.85, "brow": 0.3, "browAngSym": 0.6, "mouthForm": -0.3, "mouthCForm": -0.45 } },
    "sleepy":   { "params": { "eyeOpenL": 0.35, "eyeOpenR": 0.35, "brow": -0.1, "mouthForm": 0 } }
  },

  "motions": {
    "nod": {
      "duration": 900, "fadeIn": 120, "fadeOut": 200, "mode": "add",
      "tracks": {
        "angleY": [[0, 0], [220, -0.45, "easeOut"], [480, 0.12, "easeInOut"], [900, 0, "easeInOut"]],
        "angleZ": [[0, 0], [300, 0.08], [900, 0]]
      }
    },
    "doubleNod": {
      "duration": 1400, "fadeIn": 100, "fadeOut": 200, "mode": "add",
      "tracks": {
        "angleY": [[0, 0], [200, -0.4, "easeOut"], [420, 0.05], [640, -0.4, "easeOut"], [900, 0.05], [1400, 0, "easeInOut"]]
      }
    },
    "glanceAtUser": {
      "duration": 1600, "fadeIn": 150, "fadeOut": 350, "mode": "override",
      "tracks": {
        "angleX": [[0, 0], [1600, 0]],
        "angleY": [[0, 0.1], [1600, 0.1]],
        "eyeX":   [[0, 0], [1600, 0]],
        "eyeY":   [[0, 0], [1600, 0]]
      }
    },
    "tiltAndTalk": {
      "duration": 2200, "fadeIn": 200, "fadeOut": 400, "mode": "add",
      "tracks": {
        "angleZ": [[0, 0], [350, 0.5, "easeOut"], [1900, 0.45], [2200, 0, "easeInOut"]],
        "angleX": [[0, 0], [350, 0.2, "easeOut"], [2200, 0]],
        "brow":   [[0, 0], [300, 0.3], [2000, 0.3], [2200, 0]]
      },
      "events": [{ "t": 300, "talk": 1500 }]
    },
    "lookDownSulk": {
      "duration": 2600, "fadeIn": 300, "fadeOut": 500, "mode": "add",
      "tracks": {
        "angleY": [[0, 0], [600, -0.35, "easeOut"], [2200, -0.3], [2600, 0, "easeInOut"]],
        "angleX": [[0, 0], [600, -0.35, "easeOut"], [2200, -0.3], [2600, 0, "easeInOut"]],
        "eyeX":   [[0, 0], [600, -0.6], [2200, -0.6], [2600, 0]]
      }
    },
    "lookAround": {
      "duration": 3200, "fadeIn": 200, "fadeOut": 400, "mode": "add",
      "tracks": {
        "angleX": [[0, 0], [700, -0.6, "easeInOut"], [1500, -0.6], [2300, 0.6, "easeInOut"], [2800, 0.6], [3200, 0, "easeInOut"]],
        "eyeX":   [[0, 0], [600, -0.9, "easeInOut"], [1500, -0.9], [2200, 0.9, "easeInOut"], [2800, 0.9], [3200, 0, "easeInOut"]],
        "brow":   [[0, 0], [500, 0.25], [2800, 0.25], [3200, 0]]
      }
    },
    "perkUp": {
      "duration": 1100, "fadeIn": 80, "fadeOut": 250, "mode": "add",
      "tracks": {
        "angleY": [[0, 0], [180, 0.35, "easeOut"], [600, 0.1], [1100, 0, "easeInOut"]],
        "body":   [[0, 0], [200, 0.2], [1100, 0]],
        "brow":   [[0, 0], [150, 0.5], [800, 0.4], [1100, 0]]
      }
    },
    "turnAway": {
      "duration": 2400, "fadeIn": 150, "fadeOut": 500, "mode": "add",
      "tracks": {
        "angleX": [[0, 0], [400, 0.7, "easeOut"], [1900, 0.65], [2400, 0, "easeInOut"]],
        "angleZ": [[0, 0], [400, -0.3, "easeOut"], [1900, -0.3], [2400, 0]],
        "eyeX":   [[0, 0], [400, -0.8, "easeOut"], [1900, -0.8], [2400, 0]]
      }
    },
    "stretch": {
      "duration": 2600, "fadeIn": 300, "fadeOut": 500, "mode": "add",
      "tracks": {
        "angleY": [[0, 0], [700, 0.45, "easeOut"], [1800, 0.45], [2600, 0, "easeInOut"]],
        "body":   [[0, 0], [700, -0.3], [1400, 0.3], [2600, 0]],
        "armY":   [[0, 0], [700, 0.8, "easeOut"], [1800, 0.8], [2600, 0, "easeInOut"]],
        "eyeOpenL": [[0, 0], [600, -0.8], [1800, -0.8], [2400, 0]],
        "eyeOpenR": [[0, 0], [600, -0.8], [1800, -0.8], [2400, 0]],
        "mouthOpen": [[0, 0], [700, 0.7], [1600, 0.7], [2100, 0]]
      }
    }
  },

  "reactions": {
    "GREETING":    [ { "motion": "nod", "expression": "smile", "hold": 1800, "talk": 1200 } ],
    "FOCUS_START": [ { "motion": "nod", "expression": "softSmile", "hold": 1500 },
                     { "motion": "perkUp", "expression": "softSmile", "hold": 1500 } ],
    "GAZE_AWAY": [
      { "intensity": 1, "motion": "glanceAtUser", "expression": "stare",   "hold": 1600 },
      { "intensity": 2, "motion": "tiltAndTalk",  "expression": "worried", "hold": 2200 },
      { "intensity": 3, "motion": "lookDownSulk", "expression": "pout",    "hold": 2600 }
    ],
    "AWAY": [
      { "intensity": 1, "motion": "lookAround", "expression": "worried", "hold": 3200 },
      { "intensity": 2, "motion": "lookAround", "expression": "worried", "hold": 3200, "talk": 1200 },
      { "intensity": 3, "motion": "turnAway",   "expression": "pout",    "hold": 2400 }
    ],
    "RETURN": [
      { "intensity": 1, "motion": "perkUp",    "expression": "softSmile", "hold": 1500 },
      { "intensity": 2, "motion": "doubleNod", "expression": "smile",     "hold": 1800, "talk": 1000 },
      { "intensity": 3, "motion": "turnAway",  "expression": "pout",      "hold": 2400, "then": "softSmile" }
    ],
    "LONG_FOCUS":  [ { "motion": "doubleNod", "expression": "smile", "hold": 2000 } ],
    "IDLE": [ { "motion": "stretch", "weight": 1 }, { "expression": "sleepy", "hold": 2500, "weight": 2 } ]
  }
}
